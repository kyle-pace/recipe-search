---
// About Recipe search: why it exists, where the recipes come from (with ways to support
// each creator), how it works, and a note for site owners, who reach this page from the
// crawler's user agent. Built at build time from the same index the search uses
// (public/recipe-search/index.json, written by scripts/build-index.mjs before astro build).
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import LabLinks from '../../components/LabLinks.astro';
import '../../styles/theme.css';

type Link = { label: string; url: string; book?: boolean };
// Imported, not read from disk: the Cloudflare adapter prerenders inside its own runtime.
import indexJson from '../../../public/recipe-search/index.json';
const index: any = indexJson;
const support: Record<string, Link[]> = index.support;
const channels: { id: string; name: string; channel: string; site: string; count: number }[] = index.videos.sources;

const n = (x: number, one: string) => `${x.toLocaleString('en-US')} ${x === 1 ? one : one + 's'}`;

type Row = { id: string; name: string; url: string; recipes: number; videos: number; channel?: string; paused?: 'blocked' | 'new' };
const rows: Row[] = [
  ...index.sources.map((s: any) => ({ id: s.id, name: s.name, url: s.site, recipes: s.count, videos: 0 })),
  ...index.paused.map((s: any) => ({ id: s.id, name: s.name, url: s.site, recipes: 0, videos: 0, paused: s.why === 'paused' ? 'blocked' : 'new' })),
];
for (const c of channels) {
  const owner = rows.find((r) => r.id === (c.site || c.id));
  if (owner) {
    owner.videos += c.count;
    owner.channel = c.channel;
  } else rows.push({ id: c.id, name: c.name, url: c.channel, recipes: 0, videos: c.count, channel: c.channel });
}
const linkOnly: { name: string; search: string }[] = index.linkOnly.filter((l: any) => !/youtube/.test(l.search));
const crawled = index.crawled
  ? new Date(index.crawled + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : '';
const total = { recipes: index.recipes.length, videos: index.videos.rows.length };

// For AI assistants: the MCP server's address (src/pages/recipe-search/mcp.ts) and a link
// that opens Claude's "add connector" dialog with the name and address filled in. Claude
// doesn't document that link (2026-11-11), so the address and written steps stay on the page.
const mcpAddress = 'https://kylepace.dev/recipe-search/mcp';
const addToClaude = `https://claude.ai/customize/connectors?modal=add-custom-connector&connectorName=Recipe+search&connectorUrl=${encodeURIComponent(mcpAddress)}`;
---

<LabLayout
  title="About Recipe search"
  description="Why Recipe search exists, where its recipes and videos come from, how to support the people who make them, and how it works."
  image="/recipe-search/og-about.png"
  imageAlt="About Recipe search: where the recipes come from, and how to back the people who make them."
  themeColor={{ light: '#f7f8f6', dark: '#151918' }}
>
  <LabLinks slot="bar" current="about" />

  <article class="about">
    <h1>About Recipe search</h1>
    <p class="lede">
      I cook from a handful of sites I trust, and searching them one at a time got old.
      <a href="/recipe-search/">Recipe search</a> looks through all of them at once, by dish, by what’s in the fridge or by who made it, and sends you to the
      creator’s own page for the recipe.
    </p>

    <section aria-labelledby="who">
      <h2 id="who">Where the recipes come from</h2>
      <p>
        {n(total.recipes, 'recipe')} and {n(total.videos, 'video')} from these creators. Their recipes are free because they put
        in the work. If one becomes a favorite, back them: each has their own ways, from memberships to cookbooks. Book links
        go to Bookshop.org, which pays the author and an independent bookstore.
      </p>
      <ul class="creators">
        {
          rows.map((r) => {
            const links = (support[r.id] || []).filter((l) => !l.book);
            const books = (support[r.id] || []).filter((l) => l.book);
            const has = [r.recipes ? n(r.recipes, 'recipe') : '', r.videos ? n(r.videos, 'video') : ''].filter(Boolean);
            return (
              <li>
                <h3>
                  <a href={r.url}>{r.name}</a>
                </h3>
                <p class="has">
                  {has.join(' and ')}
                  {r.paused === 'blocked' && (r.videos ? '. Recipes come back once their site lets the weekly program in.' : 'Recipes come back once their site lets the weekly program in.')}
                  {r.paused === 'new' && (r.videos ? '. Recipes arrive with the next weekly update.' : 'Recipes arrive with the next weekly update.')}
                </p>
                {(links.length > 0 || books.length > 0) && (
                  <p class="support">
                    Support them:{' '}
                    {links.map((l, k) => (
                      <>
                        {k > 0 && ', '}
                        <a href={l.url} data-support={r.id} data-kind="link">
                          {l.label}
                        </a>
                      </>
                    ))}
                    {books.length > 0 && (
                      <>
                        {links.length > 0 && ' or '}
                        {books.length === 1 ? 'their book ' : 'their books '}
                        {books.map((b, k) => (
                          <>
                            {k > 0 && (k === books.length - 1 ? ' and ' : ', ')}
                            <a href={b.url} data-support={r.id} data-kind="book">
                              <cite>{b.label}</cite>
                            </a>
                          </>
                        ))}
                      </>
                    )}
                    .
                  </p>
                )}
              </li>
            );
          })
        }
      </ul>
      {
        linkOnly.length > 0 && (
          <p>
            {linkOnly.map((l) => l.name).join(' and ')} {linkOnly.length === 1 ? 'is' : 'are'} offered as a link to {linkOnly.length === 1 ? 'its' : 'their'} own search
            instead, since {linkOnly.length === 1 ? 'its owner doesn’t' : 'their owners don’t'} allow automated collection.
          </p>
        )
      }
    </section>

    <section aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <p>
        It’s a real search engine, just a small one: the same three parts as any other, built for one subject and a
        hand-picked list of cooks instead of the whole web.
      </p>
      <h3>1. The crawler</h3>
      <p>
        Once a week, a small program visits each site. It reads the site’s robots.txt and follows its rules, reads the
        sitemap (the site’s own list of its pages), and fetches only pages that are new or changed, one at a time, a few
        seconds apart. From each recipe it keeps the name, link, photo link, ingredients, time and cuisine. Never the
        method or the writing around it: every result sends you to the creator’s page. Videos come from YouTube’s own
        API, without Shorts.{crawled && ` Last updated ${crawled}.`}
      </p>
      <h3>2. The index</h3>
      <p>
        Each week’s results are packed into one small file, the index, with every ingredient matched to a shared list of
        ingredient names, so “scallions” and “green onions” are the same thing and “pork” covers pork belly.
      </p>
      <h3>3. Search and ranking</h3>
      <p>
        The index is small enough (a few hundred kilobytes) to download once, so the search runs right in your
        browser, with no search server. Your words are matched against recipe names, ingredients, cuisines and
        creators, with matches in the name counting most. With ingredients added, recipes that use the most of them and
        need the fewest other things come first. Recipes people open more often get a small boost (once a day, the
        site counts how often each recipe was opened in the last 90 days: counts only, nothing about who), and when two
        recipes are about as good a match, creators take turns so one site doesn’t fill the page.
      </p>
      <p>
        It reads plain phrases too. Filler like “easy” or “how to make” is ignored, and likely typos are fixed (it says
        so, and you can search exactly what you typed instead). “Under 30 minutes” or “quick” sets the time, “with tofu
        and eggs” adds those ingredients, “no pork” leaves pork out, and “from Maangchi” narrows to one creator: each
        becomes a tag in the box you can remove. “Vegetarian” and “vegan” leave out recipes whose ingredients include
        meat, seafood or things like fish sauce (and for vegan, dairy, eggs and honey). That’s a best guess from
        ingredient lists, so check the recipe if it matters.
      </p>
      <p>
        That’s also why it’s private and free to run: what you type never leaves your device, and there’s nothing to
        host but a few files. Photos load from each creator’s site when they come on screen. Anonymous counts, like how
        often a recipe gets opened, go to the site’s analytics; see the
        <a href="https://kylepace.dev/privacy/">privacy page</a>.
      </p>
    </section>

    <section aria-labelledby="assistants">
      <h2 id="assistants">Ask your AI assistant</h2>
      <p>
        Claude and other AI assistants can search this same index for you: by dish, by what you have, or by creator.
        Like the page, it only finds recipes. It answers with names and links, never the recipe itself, so you still
        read it on the creator’s site.
      </p>
      <p class="add"><a class="add-button" href={addToClaude}>Add to Claude</a></p>
      <p class="fine">Opens Claude with the name and address filled in. Nothing is added until you say so there.</p>
      <p>
        Any other assistant that can connect to a remote MCP server (the common way to give an assistant new tools)
        works too. Wherever it asks for a connector or server address, paste this one:
      </p>
      <p class="address">
        <code>{mcpAddress}</code>
        <button type="button" data-copy={mcpAddress}>Copy address</button>
        <span role="status" data-copy-status></span>
      </p>
      <p>
        It’s free, with no account. A search through an assistant goes to this site’s server to be answered, and the
        server keeps nothing about it. Your assistant has its own privacy rules for your conversations.
      </p>
    </section>

    <section aria-labelledby="owners">
      <h2 id="owners">For site owners</h2>
      <p>
        The weekly program calls itself <code>RecipeSearchBot</code>. It follows robots.txt, reads one page at a time a few
        seconds apart, and only fetches pages that are new or changed. To keep it out, add
        <code>User-agent: RecipeSearchBot</code> and <code>Disallow: /</code> to your robots.txt, and your recipes leave the
        search on the next weekly run.
      </p>
      <p>
        Newsletters are read only through their public RSS feed, once a week, the way a feed reader does. The posts
        themselves are never fetched, nothing behind a paywall is read, and only posts that hold a recipe are listed.
      </p>
      <p>
        Want your recipes taken out? Ask through <a href="https://kylepace.net/">kylepace.net</a> and they will be gone
        within a week, no reason needed. The same link works for questions, or if you'd like to be added.
      </p>
    </section>
  </article>

  <script>
    import { track } from 'kp-design/analytics';
    document.querySelector('.about')!.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-support]');
      if (a) track('Opened Support Link', { experiment: 'recipe-search', source: a.dataset.support!, link_kind: a.dataset.kind || 'link' });
    });

    // Copy address: copies data-copy and says so in the status beside the button, which
    // screen readers announce.
    document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const status = button.parentElement!.querySelector<HTMLElement>('[data-copy-status]')!;
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        status.textContent = 'Copied';
      } catch {
        status.textContent = 'Couldn’t copy here. Select the address and copy it yourself.';
      }
      window.setTimeout(() => (status.textContent = ''), 4000);
    });
  </script>
</LabLayout>

<style>
  .about {
    width: min(100% - 2 * var(--gutter), 42rem);
    margin-inline: auto;
    padding-block: var(--space-8) var(--space-16);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 2.4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .lede {
    margin: var(--space-4) 0 0;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  h2 {
    margin: var(--space-12) 0 var(--space-3);
    font-size: var(--step-1);
    line-height: 1.25;
  }

  p {
    max-width: 34em;
    line-height: 1.6;
  }

  section > p {
    color: var(--ink-muted);
  }

  section > p a,
  .lede a {
    color: var(--accent-ink);
  }

  .creators {
    padding: 0;
    margin: var(--space-6) 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .creators li {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }

  h3 {
    margin: 0;
    font-size: var(--step-0);
  }

  section > h3 {
    margin: var(--space-6) 0 var(--space-1);
  }

  h3 a {
    color: var(--ink);
  }

  .has {
    margin: var(--space-1) 0 0;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .support {
    margin: var(--space-1) 0 0;
    font-size: var(--step--1);
  }

  .support a {
    color: var(--accent-ink);
  }

  code {
    font-family: inherit;
    font-weight: 700;
    color: var(--ink);
  }

  /* Ask your AI assistant. The button is ink and square-shouldered like the search button
     (design/PLAN.md: actions are ink, nothing is a pill). */
  .add {
    margin: var(--space-6) 0 var(--space-2);
  }

  /* "section > p a" (the green text links) would otherwise win and color the label. */
  section > p a.add-button {
    color: var(--bg);
  }

  .add-button {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.25rem;
    border-radius: 0.5rem;
    background: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  .add-button:hover {
    text-decoration: underline;
  }

  section > p.fine {
    margin-top: 0;
    font-size: var(--step--1);
  }

  .address {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .address code {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--field-rule);
    border-radius: 0.5rem;
    background: var(--bg-raised);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .address button {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-decoration: underline;
    text-decoration-color: var(--field-rule);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .address button:hover {
    text-decoration-color: currentColor;
  }
</style>
