---
// Recipe search: one search across the recipe sites Kyle trusts, from our own index
// (public/recipe-search/index.json, built from data/ by scripts/build-index.mjs).
// src/scripts/search.ts loads the index and searches it in the browser.
//
// One search box, centered like a search engine's home page; after a search it moves up
// and results fill the page. Ingredients and creators picked from the suggestions become
// tags in the box. design/PLAN.md has the reasoning. About is its own page (about.astro).
// It's a standalone lab: LabLayout gives it only a back link, a footer line, display
// settings and analytics; its look is src/styles/theme.css.
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import LabLinks from '../../components/LabLinks.astro';
import '../../styles/theme.css';
---

<LabLayout
  title="Recipe search"
  description="Search The Woks of Life, Hot Thai Kitchen, Smitten Kitchen and more at once, by dish, by what you have or by creator. Every recipe opens on its own site."
  image="/recipe-search/og.png"
  imageAlt="Recipe search: a search box holding ginger and tofu. Recipes from The Woks of Life, Hot Thai Kitchen, Smitten Kitchen and more."
  themeColor={{ light: '#f7f8f6', dark: '#151918' }}
>
  <link slot="head" rel="preload" href="/recipe-search/index.json" as="fetch" crossorigin="anonymous" />
  <script slot="head" is:inline>
    // The About section used to live at #about; it's its own page now.
    if (location.hash === '#about') location.replace('/recipe-search/about/');
  </script>
  <LabLinks slot="bar" current="search" />

  <div class="page" id="page" data-mode="home">
    <div class="app" id="app" data-state="loading">
      <header class="top">
        <h1><a href="/recipe-search/" id="home-link">Recipe search</a></h1>
        <p class="from" id="from">Recipes and videos from the cooks I trust. Every one opens on its creator’s own site.</p>
      </header>

      <form class="search" id="search-form" role="search" action="/recipe-search/" method="get" aria-label="Recipes">
        <label class="visually-hidden" for="q">Search recipes by dish, ingredient or creator</label>
        <div class="box" id="box">
          <ul class="tags" id="with-chips" aria-label="Added to your search"></ul>
          <input
            id="q"
            name="q"
            type="text"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="search"
            placeholder="A dish, ingredient or creator"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="q-list"
            aria-describedby="q-hint"
          />
          <button class="go" type="submit">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"></circle><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
            <span class="visually-hidden">Find recipes</span>
          </button>
          <div class="panel" id="q-panel" hidden>
            <div class="list" id="q-list" role="listbox" aria-label="Suggestions"></div>
          </div>
        </div>
        <p id="q-hint" class="visually-hidden">Suggestions appear as you type. Pick an ingredient or creator to add it to your search. Backspace in an empty box removes the last one.</p>
        <p class="home-actions"><button class="lucky" type="button" id="lucky">Pick one at random</button></p>
      </form>

      <div class="filters" role="group" aria-label="Narrow it down">
        <button class="filter" type="button" popovertarget="f-show" id="f-show-btn">Show: <span id="f-show-value">recipes and videos</span></button>
        <button class="filter" type="button" popovertarget="f-cuisine" id="f-cuisine-btn">Cuisine: <span id="f-cuisine-value">any</span></button>
        <button class="filter" type="button" popovertarget="f-site" id="f-site-btn">Creator: <span id="f-site-value">any</span></button>
        <button class="filter" type="button" popovertarget="f-time" id="f-time-btn">Time: <span id="f-time-value">any</span></button>
        <button class="lucky" type="button" id="lucky-results">Pick one at random</button>
        <button class="clear-all" type="button" id="clear-all" hidden>Start over</button>
      </div>

      <div class="pop" id="f-show" popover>
        <fieldset><legend>Show</legend><div class="options" id="f-show-options"></div></fieldset>
      </div>
      <div class="pop" id="f-cuisine" popover>
        <fieldset><legend>Cuisine</legend><div class="options" id="f-cuisine-options"></div></fieldset>
      </div>
      <div class="pop" id="f-site" popover>
        <fieldset><legend>Creators</legend><div class="options" id="f-site-options"></div></fieldset>
      </div>
      <div class="pop" id="f-time" popover>
        <fieldset><legend>Ready in</legend><div class="options" id="f-time-options"></div></fieldset>
      </div>

      <p class="status" id="status" role="status" aria-live="polite">Loading the recipes…</p>

      <section class="start" id="start" aria-label="Ideas" hidden>
        <p id="try"></p>
        <p id="popular"></p>
        <p id="creators"></p>
      </section>

      <section class="picked" id="picked" aria-labelledby="picked-title" hidden tabindex="-1">
        <h2 id="picked-title">Picked at random</h2>
        <div id="picked-card"></div>
        <button class="lucky" type="button" id="lucky-again">Pick another</button>
      </section>

      <h2 class="visually-hidden" id="results-title">Recipes</h2>
      <ol class="results" id="results" aria-labelledby="results-title"></ol>
      <button class="more" type="button" id="more" hidden>Show more</button>

      <section class="videos" id="videos" aria-labelledby="videos-title" hidden>
        <h2 id="videos-title">On YouTube</h2>
        <ol class="results" id="video-results"></ol>
        <button class="more" type="button" id="more-videos" hidden>Show more</button>
      </section>

      <section class="empty" id="empty" aria-label="Nothing found" hidden>
        <p id="fixes"></p>
      </section>

      <p class="also" id="also" hidden></p>

      <noscript>
        <p class="status">
          Search runs in your browser, so it needs JavaScript. You can still search
          <a href="https://thewoksoflife.com/?s=">The Woks of Life</a>,
          <a href="https://hot-thai-kitchen.com/?s=">Hot Thai Kitchen</a> and
          <a href="https://smittenkitchen.com/?s=">Smitten Kitchen</a> directly.
        </p>
      </noscript>
    </div>
  </div>

  <script>
    import '../../scripts/search.ts';
  </script>
</LabLayout>

<style>
  .page {
    width: min(100% - 2 * var(--gutter), 68rem);
    margin-inline: auto;
    padding-block: var(--space-4) var(--space-12);
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .app [hidden] {
    display: none !important;
  }

  /* ---------------------------------------------------------------------------------
     Two modes. Home: the name and the box, centered in the window, a search engine's
     front page. Results: the box moves up, left-aligned, and results fill the page. */
  .top h1 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .top h1 a {
    color: var(--ink);
    text-decoration: none;
  }

  .from {
    max-width: 36rem;
    margin: var(--space-1) 0 0;
    color: var(--ink-muted);
  }

  .search {
    max-width: 44rem;
    margin-top: var(--space-6);
  }

  [data-mode='home'] .app {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - 14rem);
    padding-bottom: 6vh;
  }

  [data-mode='home'] .top,
  [data-mode='home'] .search,
  [data-mode='home'] .start {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  [data-mode='home'] .top h1 {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.75rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  [data-mode='home'] .from {
    max-width: none;
    margin-top: var(--space-3);
  }

  [data-mode='home'] .search {
    margin-top: var(--space-8);
  }

  [data-mode='home'] .filters,
  [data-mode='home'] .status:empty,
  [data-mode='results'] .home-actions,
  [data-mode='results'] .from {
    display: none;
  }

  /* ---------------------------------------------------------------------------------
     The box. Square-shouldered, a firm rule, tags marked like a highlighter on a
     shopping list. */
  .box {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-height: 3.5rem;
    padding: var(--space-2) 3.5rem var(--space-2) var(--space-4);
    border: 1px solid var(--field-rule);
    border-radius: 0.5rem;
    background: var(--bg-raised);
    text-align: left;
    cursor: text;
  }

  .box:focus-within {
    border-color: var(--accent-ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-ink) 30%, transparent);
  }

  .tags {
    display: contents;
    list-style: none;
  }

  .tags :global(.tag) {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 2.25rem;
    padding: 0 0.55em;
    margin: 0;
    border: 0;
    border-radius: 0.3rem;
    background: var(--scallion-fill);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  /* A creator reads as "from Maangchi": the "from" quiet, the name plain. */
  .tags :global(.tag-creator) {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--scallion-fill);
  }

  /* Leaving something out ("no pork"): a plain outline, the word "no" says what it means. */
  .tags :global(.tag-not) {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--field-rule);
  }

  .tags :global(.x) {
    font-weight: 400;
    font-size: 1.15em;
    line-height: 1;
    color: var(--ink-muted);
  }

  .tags :global(.tag:hover .x),
  .tags :global(.tag:focus-visible .x) {
    color: var(--chili);
  }

  .box input {
    flex: 1 1 12rem;
    min-width: 8rem;
    min-height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    /* Safari draws its own inner shadow along the top of a text field; the box is the field here. */
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--step-1);
  }

  .box input::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }

  .box input:focus {
    outline: none;
  }

  .go {
    position: absolute;
    top: 50%;
    right: 0.35rem;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 0.35rem;
    background: var(--ink);
    color: var(--bg);
    cursor: pointer;
  }

  .go:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  /* Suggestions: a plain list under the box. */
  .panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.4rem);
    left: -1px;
    right: -1px;
    padding: var(--space-2);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.16);
    line-height: 1.35;
    text-align: left;
    cursor: default;
  }

  .list {
    display: block;
  }

  .panel :global([role='option']) {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border-radius: 0.35rem;
    cursor: pointer;
  }

  .panel :global([role='option'][aria-selected='true']) {
    background: var(--scallion-fill);
  }

  /* A line between things you add (creators, ingredients) and recipes you open. */
  .panel :global([data-kind='creator'] + [data-kind='recipe']),
  .panel :global([data-kind='ing'] + [data-kind='recipe']),
  .panel :global([data-kind='recipe'] + [data-kind='all']) {
    margin-top: var(--space-1);
    box-shadow: 0 -1px 0 var(--line);
  }

  .panel :global(.opt-thumb) {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.35rem;
    object-fit: cover;
    background: var(--line);
  }

  .panel :global(.opt-text) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .panel :global(.opt-meta) {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .panel :global([aria-selected='true'] .opt-meta) {
    color: var(--ink);
  }

  .panel :global(mark) {
    background: var(--scallion-fill);
    color: inherit;
    border-radius: 0.1em;
  }

  .panel :global(.opt-name) {
    font-weight: 700;
  }

  .home-actions {
    margin: var(--space-4) 0 0;
  }

  .lucky,
  .clear-all,
  .more,
  .status :global(button),
  .empty :global(button),
  .start :global(button) {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-decoration: underline;
    text-decoration-color: var(--field-rule);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .lucky:hover,
  .clear-all:hover,
  .more:hover,
  .start :global(:is(button, a):hover) {
    text-decoration-color: currentColor;
  }

  .start :global(button),
  .empty :global(button),
  .status :global(button) {
    min-height: 0;
    padding-block: 0.4rem;
  }


  .start {
    margin-top: var(--space-8);
  }

  .start p {
    margin: 0 auto var(--space-1);
    max-width: 38em;
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .start :global(a) {
    color: var(--ink);
    text-decoration-color: var(--field-rule);
    text-underline-offset: 0.2em;
  }

  .start :global(.keep) {
    white-space: nowrap;
  }

  /* ---------------------------------------------------------------------------------
     Filters: words, not pills. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    align-items: center;
    margin-top: var(--space-3);
    font-size: var(--step--1);
  }

  /* "Pick one at random" and "Start over" sit at the far end. */
  .filters .lucky {
    margin-left: auto;
  }

  /* Phones: one line that scrolls sideways, fading at the edge so it reads as more. */
  @media (max-width: 40rem) {
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
    }

    .filters > * {
      flex: none;
    }

    .filters .lucky {
      margin-left: 0;
    }
  }

  .filter {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-muted);
    font: inherit;
    cursor: pointer;
  }

  .filter span {
    color: var(--ink);
    font-weight: 600;
  }

  /* The chevron says "this opens a list"; the empty alt keeps screen readers off it. */
  .filter span::after {
    content: ' ▾' / '';
    color: var(--ink-muted);
    font-weight: 400;
  }

  /* A filter that's set: underlined in nori, so it isn't color alone. */
  .filter[data-active] span {
    text-decoration: underline;
    text-decoration-color: var(--accent-ink);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.3em;
  }

  .pop {
    margin: 0;
    min-width: 15rem;
    max-width: min(22rem, calc(100vw - 2 * var(--gutter)));
    max-height: min(26rem, 70vh);
    overflow: auto;
    padding: var(--space-4) var(--space-6);
    background: var(--bg-raised);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.16);
  }

  .pop fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .pop legend {
    padding: 0;
    margin-bottom: var(--space-2);
    font-weight: 700;
  }

  .options :global(label) {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-height: 2.75rem;
    cursor: pointer;
  }

  .options :global(input) {
    width: 1.2rem;
    height: 1.2rem;
    accent-color: var(--accent-ink);
  }

  .options :global(.count) {
    margin-left: auto;
    padding-left: var(--space-4);
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 40rem) {
    .pop {
      inset: auto 0 0 0 !important;
      max-width: none;
      width: 100%;
      border-radius: 0.75rem 0.75rem 0 0;
      padding-bottom: calc(var(--space-8) + env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pop:popover-open {
      animation: pop-in var(--duration-fast) var(--ease-out);
    }

    @keyframes pop-in {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
    }
  }

  .status {
    margin: var(--space-4) 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .status :global(strong) {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* ---------------------------------------------------------------------------------
     Results: rows, photo on the left, like a page from a recipe index. */
  .results {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8) var(--space-12);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (min-width: 60rem) {
    .results {
      grid-template-columns: 1fr 1fr;
    }
  }

  .results :global(.row),
  .picked :global(.row) {
    position: relative;
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  @media (max-width: 30rem) {
    .results :global(.row) {
      grid-template-columns: 6.5rem 1fr;
      gap: var(--space-3);
    }
  }

  :global(.row .photo) {
    grid-row: 1;
    grid-column: 1;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.35rem;
    background: var(--line);
  }

  :global(.row .photo img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.row .no-photo) {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-2);
    font-size: var(--step--1);
    text-align: center;
    color: var(--ink-muted);
  }

  :global(.row .text) {
    grid-row: 1;
    grid-column: 2;
  }

  :global(.row h3) {
    margin: 0 0 var(--space-1);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
  }

  :global(.row h3 a) {
    color: var(--ink);
    text-decoration: none;
  }

  /* The whole row is the link's hit area; the name stays the accessible name. */
  :global(.row h3 a::after) {
    content: '';
    position: absolute;
    inset: -0.25rem;
  }

  :global(.row h3 a:focus-visible) {
    outline: none;
  }

  :global(.row h3 a:focus-visible::after) {
    outline: 3px solid var(--accent-ink);
    outline-offset: 2px;
    border-radius: 0.4rem;
  }

  :global(.row:hover h3 a) {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.15em;
  }

  :global(.row .meta),
  :global(.row .uses) {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  :global(.row .uses) {
    margin-top: var(--space-1);
    color: var(--ink);
  }

  .more {
    display: block;
    margin-top: var(--space-8);
  }

  .picked {
    margin: var(--space-4) 0 var(--space-12);
    padding: var(--space-6);
    border-radius: 0.6rem;
    background: var(--scallion-fill);
  }

  .picked:focus {
    outline: none;
  }

  .picked :global(.row) {
    grid-template-columns: minmax(8rem, 16rem) 1fr;
  }

  .picked :global(.row h3) {
    font-size: var(--step-2);
  }

  .picked :global(.meta) {
    color: var(--ink);
  }

  .picked .lucky {
    margin-top: var(--space-4);
    color: var(--ink);
  }

  @media (max-width: 30rem) {
    .picked :global(.row) {
      grid-template-columns: 1fr;
    }
  }

  .videos {
    margin-top: var(--space-12);
  }

  .empty p {
    max-width: 32em;
    line-height: 1.9;
  }

  .also {
    margin-top: var(--space-12);
    color: var(--ink-muted);
  }

  :global(.support) {
    max-width: 32em;
    margin: var(--space-1) 0 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  :global(.support a) {
    font-weight: 400;
  }

  .picked :global(.support) {
    margin-top: var(--space-4);
    color: var(--ink);
  }

  .picked :global(.support a) {
    color: var(--ink);
  }

  .app[data-state='loading'] .results {
    opacity: 0.5;
  }
</style>
