---
// Recipe search: one search across the recipe sites Kyle trusts, from our own index
// (public/recipe-search/index.json, built from data/ by scripts/build-index.mjs).
// src/scripts/search.ts loads the index and searches it in the browser.
//
// The page is the sentence people actually say when they cook: "I have ginger and tofu",
// "I want to make mapo tofu". design/PLAN.md has the reasoning. It's a standalone lab:
// LabLayout gives it only a back link, a footer line, display settings and analytics;
// its look is src/styles/theme.css.
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import '../../styles/theme.css';
---

<LabLayout
  title="Recipe search"
  description="Search The Woks of Life, Hot Thai Kitchen and Smitten Kitchen at once, by dish or by what you have. Every recipe opens on its own site."
  image="/recipe-search/og.png"
  imageAlt="Recipe search: I have ginger, green onion and tofu. Recipes from The Woks of Life, Hot Thai Kitchen and Smitten Kitchen."
  themeColor={{ light: '#ffffff', dark: '#121314' }}
>
  <link slot="head" rel="preload" href="/recipe-search/index.json" as="fetch" crossorigin="anonymous" />
  <a slot="bar" class="about-link" href="#about">About</a>

  <div class="page">
    <header class="top">
      <h1>Recipe search</h1>
      <p class="from" id="from">Searches The Woks of Life, Hot Thai Kitchen and Smitten Kitchen. Every recipe opens on its own site.</p>
    </header>

    <div class="app" id="app" data-state="loading">
      <form class="ask" id="search-form" role="search" action="/recipe-search/" method="get" aria-label="Recipes">
        <div class="line">
          <label class="say" for="have">I have</label>
          <ul class="words" id="with-chips" aria-label="Your ingredients"></ul>
          <span class="field">
            <input
              id="have"
              type="text"
              autocomplete="off"
              autocapitalize="none"
              spellcheck="false"
              enterkeyhint="done"
              placeholder="an ingredient"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="have-list"
              aria-describedby="have-hint"
            />
            <span class="panel" id="have-panel" hidden>
              <span class="list" id="have-list" role="listbox" aria-label="Ingredients"></span>
            </span>
          </span>
          <span id="have-hint" class="visually-hidden">Type an ingredient and pick it from the list. Backspace removes the last one.</span>
        </div>

        <div class="line">
          <label class="say" for="q">I want to make</label>
          <span class="field">
            <input
              id="q"
              name="q"
              type="text"
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="search"
              placeholder="any dish"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="q-list"
            />
            <span class="panel" id="q-panel" hidden>
              <span class="list" id="q-list" role="listbox" aria-label="Recipes"></span>
            </span>
          </span>
        </div>

        <div class="actions">
          <button class="go" type="submit">Find recipes</button>
          <button class="lucky" type="button" id="lucky">Pick one at random</button>
        </div>
      </form>

      <div class="filters" role="group" aria-label="Narrow it down">
        <button class="filter" type="button" popovertarget="f-cuisine" id="f-cuisine-btn">Cuisine: <span id="f-cuisine-value">any</span></button>
        <button class="filter" type="button" popovertarget="f-site" id="f-site-btn">Site: <span id="f-site-value">any</span></button>
        <button class="filter" type="button" popovertarget="f-time" id="f-time-btn">Time: <span id="f-time-value">any</span></button>
        <button class="clear-all" type="button" id="clear-all" hidden>Start over</button>
      </div>

      <div class="pop" id="f-cuisine" popover>
        <fieldset><legend>Cuisine</legend><div class="options" id="f-cuisine-options"></div></fieldset>
      </div>
      <div class="pop" id="f-site" popover>
        <fieldset><legend>Sites</legend><div class="options" id="f-site-options"></div></fieldset>
      </div>
      <div class="pop" id="f-time" popover>
        <fieldset><legend>Ready in</legend><div class="options" id="f-time-options"></div></fieldset>
      </div>

      <p class="status" id="status" role="status" aria-live="polite">Loading the recipes…</p>

      <section class="start" id="start" aria-label="Ideas" hidden>
        <p id="popular"></p>
        <p id="try"></p>
      </section>

      <section class="picked" id="picked" aria-labelledby="picked-title" hidden tabindex="-1">
        <h2 id="picked-title">Picked at random</h2>
        <div id="picked-card"></div>
        <button class="lucky" type="button" id="lucky-again">Pick another</button>
      </section>

      <h2 class="visually-hidden" id="results-title">Recipes</h2>
      <ol class="results" id="results" aria-labelledby="results-title"></ol>
      <button class="more" type="button" id="more" hidden>Show more</button>

      <section class="videos" id="videos" aria-labelledby="videos-title" hidden>
        <h2 id="videos-title">On YouTube</h2>
        <ol class="results" id="video-results"></ol>
      </section>

      <section class="empty" id="empty" aria-label="Nothing found" hidden>
        <p id="fixes"></p>
      </section>

      <p class="also" id="also" hidden></p>

      <noscript>
        <p class="status">
          Search runs in your browser, so it needs JavaScript. You can still search
          <a href="https://thewoksoflife.com/?s=">The Woks of Life</a>,
          <a href="https://hot-thai-kitchen.com/?s=">Hot Thai Kitchen</a> and
          <a href="https://smittenkitchen.com/?s=">Smitten Kitchen</a> directly.
        </p>
      </noscript>
    </div>

    <section class="about" id="about" aria-labelledby="about-title" tabindex="-1">
      <h2 id="about-title">About</h2>
      <p>
        I cook from a handful of sites I trust, and searching them one at a time got old. This searches them together,
        by dish or by what’s in the fridge, and sends you to the creator’s own page for the recipe.
      </p>
      <p>
        These recipes are free because the people who make them put in the work. If one becomes a favorite, back them:
        each site below has its own ways, from memberships to cookbooks. Book links go to Bookshop.org, which pays the
        author and an independent bookstore.
      </p>
      <h3>Where the recipes come from</h3>
      <ul id="sources-list" class="sources"></ul>
      <h3>How it works</h3>
      <p>
        Once a week, a small program reads each site’s list of recipes, as its robots.txt allows, and keeps the name,
        link, photo, ingredients, time and cuisine. Never the recipe itself. The search runs in your browser, so what
        you type stays on your device. Photos load from each site when they’re on screen. <span id="crawled"></span>
      </p>
    </section>
  </div>

  <script>
    import '../../scripts/search.ts';
  </script>
</LabLayout>

<style>
  .page {
    width: min(100% - 2 * var(--gutter), 68rem);
    margin-inline: auto;
    padding-block: var(--space-4) var(--space-12);
  }

  /* The page's name is small and plain: the sentence below is the headline. */
  .top h1 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .from {
    max-width: 36rem;
    margin: var(--space-1) 0 0;
    color: var(--ink-muted);
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .app [hidden] {
    display: none !important;
  }

  /* ---------------------------------------------------------------------------------
     The sentence. Big, light words you say; bold words you add. */
  .ask {
    margin-top: var(--space-12);
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15em 0.35em;
    font-size: clamp(1.75rem, 1.05rem + 3.4vw, 3.6rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .line + .line {
    margin-top: 0.25em;
  }

  .say {
    font-weight: 300;
    color: var(--ink-muted);
  }

  .words {
    display: contents;
    list-style: none;
  }

  /* An ingredient you've added: marked like a highlighter on a shopping list. */
  .words :global(button) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2em;
    padding: 0 0.18em;
    margin: 0;
    border: 0;
    border-radius: 0.12em;
    background: var(--scallion-fill);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .words :global(.x) {
    font-weight: 300;
    font-size: 0.6em;
    color: var(--ink-muted);
  }

  .words :global(button:hover .x),
  .words :global(button:focus-visible .x) {
    color: var(--chili);
  }

  .field {
    position: relative;
    flex: 1 1 8em;
    min-width: 6.5em;
  }

  .field input {
    width: 100%;
    padding: 0 0 0.05em;
    border: 0;
    border-bottom: 0.08em solid var(--field-rule);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    letter-spacing: inherit;
  }

  .field input::placeholder {
    color: var(--ink-muted);
    font-weight: 300;
    opacity: 0.75;
  }

  .field input:focus {
    outline: none;
    border-bottom-color: var(--accent-ink);
  }

  /* Suggestions: a plain list under the word you're typing. */
  .panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.35rem);
    left: 0;
    width: min(26rem, calc(100vw - 2 * var(--gutter)));
    padding: var(--space-2);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.14);
    font-size: 1rem;
    letter-spacing: normal;
    line-height: 1.35;
  }

  .list {
    display: block;
  }

  .panel :global([role='option']) {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border-radius: 0.35rem;
    cursor: pointer;
  }

  .panel :global([role='option'][aria-selected='true']) {
    background: var(--scallion-fill);
  }

  .panel :global(.opt-thumb) {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.35rem;
    object-fit: cover;
    background: var(--line);
  }

  .panel :global(.opt-text) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .panel :global(.opt-meta) {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .panel :global([aria-selected='true'] .opt-meta) {
    color: var(--ink);
  }

  .panel :global(.opt-name) {
    font-weight: 700;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    align-items: center;
    margin-top: var(--space-8);
  }

  .go {
    min-height: 3rem;
    padding: 0 var(--space-6);
    border: 0;
    border-radius: 0.4rem;
    background: var(--accent-ink);
    color: var(--bg);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .lucky,
  .clear-all,
  .more,
  .empty :global(button),
  .start :global(button) {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent-ink);
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .start :global(button),
  .empty :global(button) {
    min-height: 0;
    padding-block: 0.4rem;
  }

  .lucky {
    font-weight: 700;
  }

  /* ---------------------------------------------------------------------------------
     Filters: words, not pills. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    align-items: center;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .filter {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-muted);
    font: inherit;
    cursor: pointer;
  }

  .filter span {
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline dotted;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.25em;
  }

  .filter[data-active] span {
    color: var(--accent-ink);
    text-decoration-style: solid;
  }

  .pop {
    margin: 0;
    min-width: 15rem;
    max-width: min(22rem, calc(100vw - 2 * var(--gutter)));
    max-height: min(26rem, 70vh);
    overflow: auto;
    padding: var(--space-4) var(--space-6);
    background: var(--bg-raised);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.16);
  }

  .pop fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .pop legend {
    padding: 0;
    margin-bottom: var(--space-2);
    font-weight: 700;
  }

  .options :global(label) {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-height: 2.75rem;
    cursor: pointer;
  }

  .options :global(input) {
    width: 1.2rem;
    height: 1.2rem;
    accent-color: var(--accent-ink);
  }

  .options :global(.count) {
    margin-left: auto;
    padding-left: var(--space-4);
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 40rem) {
    .pop {
      inset: auto 0 0 0 !important;
      max-width: none;
      width: 100%;
      border-radius: 0.75rem 0.75rem 0 0;
      padding-bottom: calc(var(--space-8) + env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pop:popover-open {
      animation: pop-in var(--duration-fast) var(--ease-out);
    }

    @keyframes pop-in {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
    }
  }

  .status {
    margin: var(--space-6) 0 var(--space-4);
    color: var(--ink-muted);
  }

  .status :global(strong) {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .start p {
    max-width: 44rem;
    margin: 0 0 var(--space-4);
    line-height: 2;
    color: var(--ink-muted);
  }

  /* ---------------------------------------------------------------------------------
     Results: rows, photo on the left, like a page from a recipe index. */
  .results {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6) var(--space-12);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (min-width: 60rem) {
    .results {
      grid-template-columns: 1fr 1fr;
    }
  }

  .results :global(.row),
  .picked :global(.row) {
    position: relative;
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  @media (max-width: 30rem) {
    .results :global(.row) {
      grid-template-columns: 6.5rem 1fr;
      gap: var(--space-3);
    }
  }

  :global(.row .photo) {
    grid-row: 1;
    grid-column: 1;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.35rem;
    background: var(--line);
  }

  :global(.row .photo img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.row .no-photo) {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-2);
    font-size: var(--step--1);
    text-align: center;
    color: var(--ink-muted);
  }

  :global(.row .text) {
    grid-row: 1;
    grid-column: 2;
  }

  :global(.row h3) {
    margin: 0 0 var(--space-1);
    font-size: var(--step-1);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  :global(.row h3 a) {
    color: var(--ink);
    text-decoration: none;
  }

  /* The whole row is the link's hit area; the name stays the accessible name. */
  :global(.row h3 a::after) {
    content: '';
    position: absolute;
    inset: -0.25rem;
  }

  :global(.row h3 a:focus-visible) {
    outline: none;
  }

  :global(.row h3 a:focus-visible::after) {
    outline: 3px solid var(--accent-ink);
    outline-offset: 2px;
    border-radius: 0.4rem;
  }

  :global(.row:hover h3 a) {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.15em;
  }

  :global(.row .meta),
  :global(.row .uses) {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  :global(.row .uses) {
    margin-top: var(--space-1);
    color: var(--ink);
  }

  :global(.row mark) {
    background: var(--scallion-fill);
    color: inherit;
    border-radius: 0.1em;
  }

  .more {
    display: block;
    margin-top: var(--space-8);
    font-weight: 700;
  }

  .picked {
    margin: var(--space-4) 0 var(--space-12);
    padding: var(--space-6);
    border-radius: 0.6rem;
    background: var(--scallion-fill);
  }

  .picked:focus {
    outline: none;
  }

  .picked :global(.row) {
    grid-template-columns: minmax(8rem, 16rem) 1fr;
  }

  .picked :global(.row h3) {
    font-size: var(--step-2);
  }

  .picked :global(.meta) {
    color: var(--ink);
  }

  .picked .lucky {
    margin-top: var(--space-4);
    color: var(--ink);
  }

  @media (max-width: 30rem) {
    .picked :global(.row) {
      grid-template-columns: 1fr;
    }
  }

  .videos {
    margin-top: var(--space-12);
  }

  .empty p {
    max-width: 44rem;
    line-height: 1.9;
  }

  .also {
    margin-top: var(--space-12);
    color: var(--ink-muted);
  }

  /* ---------------------------------------------------------------------------------
     Where these come from. */
  .about {
    max-width: 40rem;
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .about h2,
  .about h3 {
    color: var(--ink);
  }

  .about h3 {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--step-0);
  }

  .about:focus {
    outline: none;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .about-link:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .sources {
    padding: 0;
    margin: 0 0 var(--space-4);
    list-style: none;
  }

  .sources :global(li) {
    padding: var(--space-2) 0;
  }

  :global(.support) {
    margin: var(--space-1) 0 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  :global(.support a),
  .sources :global(.support a) {
    font-weight: 400;
  }

  .picked :global(.support) {
    margin-top: var(--space-4);
    color: var(--ink);
  }

  .picked :global(.support a) {
    color: var(--ink);
  }

  .sources :global(a) {
    font-weight: 700;
  }

  .app[data-state='loading'] .results {
    opacity: 0.5;
  }
</style>
