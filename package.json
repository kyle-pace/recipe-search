{
  "name": "recipe-search",
  "private": true,
  "type": "module",
  "description": "One search box across the recipe sites Kyle trusts, from our own small index. Live at kylepace.dev/recipe-search/.",
  "scripts": {
    "dev": "node scripts/build-index.mjs && astro dev",
    "index": "node scripts/build-index.mjs",
    "build": "node scripts/build-index.mjs && astro build",
    "preview": "npm run build && wrangler dev",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "crawl": "node crawler/crawl.mjs",
    "test": "node --test crawler/test/*.test.mjs src/mcp/*.test.mjs",
    "try-mcp": "node scripts/try-mcp.mjs",
    "check": "node .agents/skills/page-check/check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "astro": "^7.4.7",
    "kp-design": "github:kyle-pace/kp-design#4dbd054a3c541a679643fcfebba3e6ba2ff88bba",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.65.1",
    "wrangler": "^4.158.0"
  }
}
